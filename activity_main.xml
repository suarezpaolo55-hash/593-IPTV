<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1B1B1B">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="593-IPTV 🇪🇨"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="20dp"
        android:textColor="#FFFFFF"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pega el enlace del canal aquí:"
        android:textSize="14sp"
        android:textColor="#CCCCCC"
        android:paddingBottom="8dp"/>

    <EditText
        android:id="@+id/enlaceEntrada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://ejemplo.com/canal.m3u8"
        android:inputType="textUri"
        android:background="#FFFFFF"
        android:textColor="#000000"
        android:padding="12dp"/>

    <Button
        android:id="@+id/botonReproducir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="▶️ Reproducir"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#0066CC"
        android:textColor="#FFFFFF"/>

    <VideoView
        android:id="@+id/reproductor"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"/>

</LinearLayout>
